{
  "version": 2,
  "buildCommand": "cd server && npm install && npx prisma generate",
  "installCommand": "cd server && npm install",
  "framework": null,
  "functions": {
    "api/index.js": {
      "memory": 256,
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/dashboard", "destination": "/dashboard/index.html" },
    { "source": "/dashboard/(.*)", "destination": "/dashboard/$1" },
    { "source": "/", "destination": "/website/index.html" },
    { "source": "/(.*)", "destination": "/website/$1" }
  ]
}
